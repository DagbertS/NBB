# Kopieer dit bestand naar .env en vul de echte waarden in.
# Het .env-bestand staat in .gitignore en wordt NOOIT gecommit.

# Applicatie
SECRET_KEY=vervang-dit-door-een-lange-willekeurige-string
DATABASE_PATH=data/nbb.db
DOCUMENT_STORE=data/documents

# Eerste beheerder (alleen gebruikt als er nog geen gebruikers bestaan;
# handig bij cloud-deploys zonder shell-toegang)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# KBO Open Data (https://kbopub.economie.fgov.be/kbo-open-data/)
KBO_USERNAME=
KBO_PASSWORD=

# NBB CBSO API (https://www.nbb.be/nl/balanscentrale)
# Registreer op het CBSO-portaal en maak een subscription key aan.
NBB_CBSO_SUBSCRIPTION_KEY=
NBB_CBSO_BASE_URL=https://ws.cbso.nbb.be/authentic

# Anthropic API (voor de prompt-analysefunctie)
ANTHROPIC_API_KEY=

# E-mail (voor het mailen van promptconclusies)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
